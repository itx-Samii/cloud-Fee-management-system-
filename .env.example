# Copy this file to .env.local and fill it in. Never share .env.local: it holds your database password.

# Supabase (Postgres) connection string. Required.
# In Supabase, open the project, click "Connect", copy the "Session pooler" connection string and
# put the database password in place of [YOUR-PASSWORD]. (On Vercel or other serverless hosting,
# use the "Transaction pooler" one, port 6543, instead.) A password containing @ # / ? or % must be
# URL-encoded; simplest is to reset it in Supabase to letters and numbers only.
# The app creates its tables by itself the first time it connects.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Secret that signs login cookies. Use a long random value, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, a key derived from DATABASE_URL is used instead.
SESSION_SECRET=

# Super Admin password for the very first `superadmin` login only. After that the password is
# stored (hashed) in the database and changed from the Super Admin page; this value is then ignored.
SUPERADMIN_PASSWORD=

# Optional: license key given to the default Brook Field client record.
LICENSE_KEY=
