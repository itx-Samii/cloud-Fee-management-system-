{
  "name": "fee-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "db:local": "tsx scripts/local-db.ts",
    "offline": "tsx scripts/offline.ts",
    "offline:dev": "tsx scripts/offline.ts --dev",
    "offline:setup": "tsx scripts/setup-offline.ts",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:import": "tsx scripts/import-old-data.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "mongodb": "^7.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.9"
  }
}
